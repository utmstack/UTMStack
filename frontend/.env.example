# Frontend env vars. Copy to `.env.local` and tweak if needed.

# Base URL of the Go backend API. Default `/api/v1` works in dev because
# vite.config.ts proxies /api → http://localhost:8080.
VITE_API_URL=/api/v1

# App version shown at the bottom of the sidebar. CI/release process should
# inject this from agent/version.json. Falls back to a hardcoded value in
# src/shared/config/app.ts if unset.
VITE_APP_VERSION=11.1.4
