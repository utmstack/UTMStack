# npm 8 (Node 16.20.2, S16+) enforces peer deps that npm 6 only warned about.
# The legacy Angular 8-era libs still in the tree (e.g. @fortawesome/angular-
# fontawesome@0.4.0 peers @angular/common ^8) hard-fail ERESOLVE on a plain
# `npm install`. legacy-peer-deps restores npm 6's resolution behavior so the
# committed lock (v2) installs deterministically on CI. The S17 final lib sweep
# retires these libs; re-evaluate this flag then.
legacy-peer-deps=true
