# legacy-peer-deps required (re-evaluated at S17, 2026-11-05): four libs pin
# @angular/core peers below 17 and are the highest available line that still
# works with our stack:
#   @ng-bootstrap/ng-bootstrap 11.0.1  peer ^13.0.0  (11.x = last Bootstrap-4 line;
#                                          12+ needs Bootstrap 5, which the plan rules out)
#   ng-inline-svg 13.1.2              peer ^12.0.0   (no newer Ivy release exists)
#   ng-jhipster 0.16.0                peer ^10.0.0   (fesm2015 Ivy; 0.16.0 is the last release)
#   ngx-monaco-editor 12.0.0          peer ^12.0.0   (12.0.0 is the last release; monaco 0.24)
# npm 10 (Node 18.20.8) enforces peer deps that npm 6 only warned about, so a plain
# `npm install` fails ERESOLVE. This flag restores npm 6's resolution behavior so the
# committed lockfileVersion-2 lock installs deterministically on CI. Do not remove.
legacy-peer-deps=true
