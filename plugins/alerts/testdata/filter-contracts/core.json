{
  "technology": "UTMStack shared contract runner",
  "filters": [
    "filters/utmstack/utmstack.yml"
  ],
  "rules": [],
  "fixtures": [
    {
      "name": "core_unstructured_message",
      "filter": "utmstack/utmstack.yml",
      "input": {
        "raw": "internal test event"
      },
      "expected": {
        "raw": "internal test event",
        "log.message": "internal test event"
      }
    },
    {
      "name": "core_raw_json_model",
      "filter": "utmstack/utmstack.yml",
      "raw": "{\"msg\":\"synthetic JSON event\",\"args\":{\"event-id\":17}}",
      "dataType": "utmstack",
      "dataSource": "synthetic-host",
      "expected": {
        "log.msg": "synthetic JSON event",
        "log.args.eventid": 17,
        "dataSource": "synthetic-host"
      },
      "absent": [
        "log.message"
      ],
      "rules": {}
    },
    {
      "name": "utmstack_signin_authorize_attempt",
      "filter": "utmstack/utmstack.yml",
      "raw": "{\"timestamp\":\"2026-09-27T10:00:00.000Z\",\"severity\":\"INFO\",\"msg\":\"UserJWTController.authorize: Authentication attempt registered\",\"args\":{\"username\":\"anonymous\",\"method\":\"POST\",\"path\":\"/api/authenticate\",\"remoteAddr\":\"172.18.0.5\",\"context\":\"UserJWTController.authorize\",\"traceId\":\"00000000-0000-4000-8000-0000000000c1\",\"loginAttempt\":\"jane.doe\",\"layer\":\"CONTROLLER\"},\"containerName\":\"utmstack_backend\"}",
      "dataType": "utmstack",
      "dataSource": "utmstack-lab",
      "expected": {},
      "absent": [
        "origin.ip",
        "actionResult",
        "origin.user"
      ],
      "rules": {}
    },
    {
      "name": "utmstack_signin_authorize_bad_credentials",
      "filter": "utmstack/utmstack.yml",
      "raw": "{\"timestamp\":\"2026-09-27T10:00:00.000Z\",\"severity\":\"ERROR\",\"msg\":\"UserJWTController.authorize: Bad credentials\",\"args\":{\"username\":\"anonymous\",\"method\":\"POST\",\"path\":\"/api/authenticate\",\"remoteAddr\":\"172.18.0.5\",\"context\":\"UserJWTController.authorize\",\"traceId\":\"00000000-0000-4000-8000-0000000000c1\"},\"containerName\":\"utmstack_backend\"}",
      "dataType": "utmstack",
      "dataSource": "utmstack-lab",
      "expected": {
        "actionResult": "failed"
      },
      "absent": [
        "origin.ip",
        "origin.user"
      ],
      "rules": {}
    },
    {
      "name": "utmstack_signin_authorize_login_success",
      "filter": "utmstack/utmstack.yml",
      "raw": "{\"timestamp\":\"2026-09-27T10:00:00.000Z\",\"severity\":\"INFO\",\"msg\":\"UserJWTController.authorize: Login successfully completed for user 'jane.doe'\",\"args\":{\"username\":\"jane.doe\",\"method\":\"POST\",\"path\":\"/api/authenticate\",\"remoteAddr\":\"172.18.0.5\",\"context\":\"UserJWTController.authorize\",\"traceId\":\"00000000-0000-4000-8000-0000000000c1\"},\"containerName\":\"utmstack_backend\"}",
      "dataType": "utmstack",
      "dataSource": "utmstack-lab",
      "expected": {
        "actionResult": "success",
        "origin.user": "jane.doe"
      },
      "absent": [
        "origin.ip"
      ],
      "rules": {}
    },
    {
      "name": "utmstack_signin_authorize_login_success_anonymous_args",
      "filter": "utmstack/utmstack.yml",
      "raw": "{\"timestamp\":\"2026-09-27T10:00:00.000Z\",\"severity\":\"INFO\",\"msg\":\"UserJWTController.authorize: Login successfully completed for user 'svc.reader'\",\"args\":{\"username\":\"anonymous\",\"method\":\"POST\",\"path\":\"/api/authenticate\",\"remoteAddr\":\"172.18.0.5\",\"context\":\"UserJWTController.authorize\",\"traceId\":\"00000000-0000-4000-8000-0000000000c1\"},\"containerName\":\"utmstack_backend\"}",
