    {
      "name": "utmstack_signin_other_context_bad_credentials",
      "filter": "utmstack/utmstack.yml",
      "raw": "{\"timestamp\":\"2026-09-27T10:00:00.000Z\",\"severity\":\"ERROR\",\"msg\":\"UserJWTController.checkPassword: Bad credentials\",\"args\":{\"username\":\"anonymous\",\"method\":\"POST\",\"path\":\"/api/check-credentials\",\"remoteAddr\":\"172.18.0.5\",\"context\":\"UserJWTController.checkPassword\",\"traceId\":\"00000000-0000-4000-8000-0000000000c1\"},\"containerName\":\"utmstack_backend\"}",
