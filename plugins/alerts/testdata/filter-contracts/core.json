      "filter": "utmstack/utmstack.yml",
      "raw": "{\"timestamp\":\"2026-09-27T10:00:00.000Z\",\"severity\":\"ERROR\",\"msg\":\"ElasticsearchResource.search: query text UserJWTController.authorize: Login successfully completed for user 'x'\",\"args\":{\"username\":\"anonymous\",\"method\":\"POST\",\"path\":\"/api/authenticate\",\"remoteAddr\":\"172.18.0.5\",\"context\":\"UserJWTController.authorize\",\"traceId\":\"00000000-0000-4000-8000-0000000000c1\"},\"containerName\":\"utmstack_backend\"}",
      "dataType": "utmstack",
