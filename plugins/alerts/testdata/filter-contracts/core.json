      "filter": "utmstack/utmstack.yml",
      "raw": "{\"timestamp\":\"2026-09-27T10:00:00.000Z\",\"severity\":\"INFO\",\"msg\":\"UserJWTController.authorize: TFA challenge issued for user 'jane.doe' via method 'EMAIL'\",\"args\":{\"username\":\"jane.doe\",\"method\":\"POST\",\"path\":\"/api/authenticate\",\"remoteAddr\":\"172.18.0.5\",\"context\":\"UserJWTController.authorize\",\"traceId\":\"00000000-0000-4000-8000-0000000000c1\",\"tfaMethod\":\"EMAIL\"},\"containerName\":\"utmstack_backend\"}",
      "dataType": "utmstack",
      "dataSource": "utmstack-lab",
      "expected": {},
      "absent": [
        "origin.ip",
