  "fixtures": [
    {
      "name": "Linux negative syscall return preserved",
      "filter": "linux/linux.yml",
      "input": {
        "log": {
          "type": "auditd",
          "exit": -13,
          "exe": "/usr/bin/cat",
          "comm": "cat",
          "cwd": "/home/user"
        }
      },
      "expected": {
        "log.exitCode": -13,
        "actionResult": "failure",
        "origin.path": "/usr/bin/cat",
        "origin.process": "cat",
        "log.workingDirectory": "/home/user"
