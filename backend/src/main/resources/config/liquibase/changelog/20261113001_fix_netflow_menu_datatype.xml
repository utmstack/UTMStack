<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.5.xsd">

    <!--
      Fixes #2955: "Alerts: Network Flow" menu view is always empty.

      The menu item (id 306) opens the alert list filtered by
      dataType.keyword IS network_flow, but no component emits that data
      type. The NetFlow collector and the netflow filter/rules all use
      dataType = "netflow" (agent/config/const.go DataTypeNetflow,
      filters/netflow/netflow.yml, rules/netflow/*.yml), so the view
      always matches 0 alerts even when NetFlow alerts exist.

      Update the menu url to filter on the real value, "netflow".
      Idempotent: after the rewrite the 'network_flow' token no longer
      exists on this row, so a re-run matches nothing.
    -->
    <changeSet id="20261113001_fix_netflow_menu_datatype" author="osmontero">
        <comment>Point the "Alerts: Network flow" menu at dataType=netflow (the value the agent/filter/rules actually emit) - #2955.</comment>
        <sql dbms="postgresql" splitStatements="true" stripComments="true">
            UPDATE utm_menu
               SET url = 'data/alert/view?dataType.keyword=IS->netflow&alertType=ALERT'
             WHERE id = 306
               AND url = 'data/alert/view?dataType.keyword=IS->network_flow&alertType=ALERT';
        </sql>
    </changeSet>
</databaseChangeLog>
